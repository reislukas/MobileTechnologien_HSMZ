<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@android:color/white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        android:title="Gruppen"
        android:titleTextColor="@android:color/black"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- Hinweistext zum Beitreten -->
    <TextView
        android:id="@+id/textJoinHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tippe auf eine Gruppe, um ihr beizutreten"
        android:textColor="@android:color/darker_gray"
        android:padding="16dp"
        android:textSize="16sp" />

    <!-- Gruppen erstellen -->
    <LinearLayout
        android:id="@+id/createGroupSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/editGroupNameToCreate"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Neue Gruppe erstellen"
            android:inputType="text"
            android:padding="8dp"
            android:background="@drawable/rounded_button" />

        <Button
            android:id="@+id/btnCreateGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Erstellen"
            android:layout_marginStart="8dp"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Gruppenliste -->
    <ListView
        android:id="@+id/list_groups"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
